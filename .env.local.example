MONGODB_URI=""
# Required in every environment; use a secret with at least 32 characters.
NEXTAUTH_SECRET=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
# In production this must be your deployed https:// URL — middleware.js's secure cookie check depends on it matching.

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Recommended in production: create a free Redis database at https://console.upstash.com,
# then copy its REST URL and REST token into these two values. Without both values,
# production rate limits are not shared across instances; a partial configuration fails closed.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# NODE_ENV is set by Next.js; do not configure it here.